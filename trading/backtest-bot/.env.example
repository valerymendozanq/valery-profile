# MNQ EMA 9/21 bot — configuration. Copy to .env (or export) and edit.
# Paper mode needs NO secrets. Never commit real keys.

# --- Market ---
SYMBOL=MNQ=F         # Micro E-mini Nasdaq-100 futures (Yahoo Finance symbol)
INTERVAL=1d          # daily only

# --- Strategy ---
FAST_PERIOD=9
SLOW_PERIOD=21

# --- Sizing (MNQ contracts; $2 per index point) ---
QUANTITY=1
MAX_POSITION=3
CONTRACT_MULTIPLIER=2

# --- Backfill cost assumptions (index points, per side) ---
COMMISSION_PER_SIDE=0.75
SLIPPAGE_POINTS=0.5

# --- Mode: paper (default) / testnet / live ---
# testnet/live REFUSE to start in this build (no live adapter ships). Stay on paper.
MODE=paper
MAX_CAPITAL=0        # required (>0) for any non-paper mode

# --- Broker: sim (default, local) / alpaca_paper / tradovate_demo ---
# Non-sim brokers only run under MODE=paper and only against their demo/paper hosts —
# the live hosts are hard-refused. There is no real-money code path in this build.
BROKER=sim

# alpaca_paper: REAL orders on Alpaca's PAPER account (fake money). No futures, so
# orders route to ALPACA_SYMBOL (QQQ tracks the Nasdaq-100).
ALPACA_API_KEY_ID=          # your Alpaca PAPER key id (never commit this)
ALPACA_API_SECRET_KEY=      # your Alpaca PAPER secret (never commit this)
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper host only; live host is refused
ALPACA_SYMBOL=QQQ

# tradovate_demo: REAL futures API on Tradovate's DEMO env (real MNQ contracts, fake
# money). Credentials come from the Tradovate "API Access" page. Demo host only.
TRADOVATE_USERNAME=         # your Tradovate login
TRADOVATE_PASSWORD=
TRADOVATE_CID=              # API "cid" from the API Access page
TRADOVATE_SEC=             # API secret from the API Access page
TRADOVATE_APP_ID=MNQLearningBot
TRADOVATE_BASE_URL=https://demo.tradovateapi.com/v1   # demo host only; live host is refused
TRADOVATE_ACCOUNT_SPEC=     # blank = use your first demo account
TRADOVATE_SYMBOL=MNQ        # "MNQ" auto-resolves front month, or set exact e.g. MNQM5

# --- Telegram alerts (optional; logs to stdout if unset) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- State ---
DB_PATH=data/state.db
