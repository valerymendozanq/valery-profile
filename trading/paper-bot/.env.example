# MNQ paper bot — configuration. Copy to .env and edit. NO SECRETS NEEDED.
# Market data is a public endpoint; there are no API keys in this project.

# --- Market ---
SYMBOL=MNQ=F        # Micro E-mini Nasdaq-100 futures (Yahoo Finance symbol)
INTERVAL=1d         # daily only for the EMA 9/21 strategy
RANGE=5y            # history pulled for replay (e.g. 1y, 2y, 5y, max)

# --- Strategy ---
FAST_PERIOD=9
SLOW_PERIOD=21

# --- Risk / sizing (MNQ contracts; multiplier is $2 per index point) ---
QUANTITY=1          # contracts per entry
MAX_POSITION=3      # max contracts allowed (QUANTITY > MAX_POSITION => SKIP)
CONTRACT_MULTIPLIER=2
